// Windows resources for OpenMirrorPhone.exe: icon, manifest, Settings
// dialog and version info. SDL uses the first icon for the window and taskbar.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 ICON "../assets/logo.ico"
1 24 "app.manifest" // RT_MANIFEST
PAYPAL_PNG RCDATA "../assets/paypal-donate.png" // Welcome window's donate button

IDD_SETTINGS DIALOGEX 0, 0, 432, 262
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  // Sidebar (x 0-112): page list, donation, exit. Its width is SIDEBAR_DLU in settings_dialog.cpp.
  LISTBOX       IDC_SETTINGS_NAV, 6, 8, 100, 150,
                LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_TABSTOP
  LTEXT         "Support development", -1, 8, 210, 98, 9
  CONTROL       "", IDC_DONATE, "Button", BS_OWNERDRAW | WS_TABSTOP, 6, 221, 100, 30

  // General
  LTEXT         "General", IDC_GENERAL_TITLE, 124, 8, 296, 14
  LTEXT         "Receiver name and window controls.", IDC_GENERAL_INFO, 124, 24, 296, 9
  GROUPBOX      "Receiver", IDC_RECEIVER_GROUP, 124, 40, 298, 68
  LTEXT         "Name shown in Screen Mirroring on your iPhone, iPad or Mac:", IDC_RECEIVER_LABEL, 134, 54, 278, 9
  EDITTEXT      IDC_NAME, 134, 66, 214, 14, ES_AUTOHSCROLL
  DEFPUSHBUTTON "&Apply", IDC_APPLY, 354, 65, 58, 16
  LTEXT         "Changing the name disconnects the device that is mirroring now.", IDC_NAME_NOTE, 134, 88, 278, 9
  GROUPBOX      "Window and playback", IDC_WINDOW_GROUP, 124, 116, 298, 84
  AUTOCHECKBOX  "Keep the window above other windows", IDC_ALWAYS_ON_TOP, 134, 132, 278, 10
  LTEXT         "Audio output", IDC_AUDIO_OUTPUT_LABEL, 134, 153, 52, 9
  COMBOBOX      IDC_AUDIO_OUTPUT, 188, 148, 124, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON    "Save &PNG", IDC_SCREENSHOT, 320, 148, 92, 16
  PUSHBUTTON    "&Full screen", IDC_FULLSCREEN, 134, 174, 80, 16
  PUSHBUTTON    "Start &recording", IDC_RECORDING, 220, 174, 88, 16
  PUSHBUTTON    "Recordings f&older", IDC_OPEN_RECORDINGS, 314, 174, 98, 16
  GROUPBOX      "Appearance", IDC_APPEARANCE_GROUP, 124, 204, 298, 34
  AUTOCHECKBOX  "&Dark theme", IDC_DARK_THEME, 134, 220, 278, 10

  // Keybinds
  LTEXT         "Keybinds", IDC_KEYBINDS_TITLE, 124, 8, 296, 14
  LTEXT         "Click a shortcut and press a key combination. Click elsewhere to cancel.", IDC_KEYBINDS_INFO,
                124, 24, 296, 9
  GROUPBOX      "Keyboard shortcuts", IDC_KEYBINDS_GROUP, 124, 40, 298, 194
  LTEXT         "Full screen", IDC_KEY_FULLSCREEN_LABEL, 138, 59, 140, 10
  EDITTEXT      IDC_KEY_FULLSCREEN, 286, 55, 120, 16, ES_AUTOHSCROLL | ES_READONLY | ES_CENTER | WS_TABSTOP
  LTEXT         "Leave full screen", IDC_KEY_EXIT_FULLSCREEN_LABEL, 138, 85, 140, 10
  EDITTEXT      IDC_KEY_EXIT_FULLSCREEN, 286, 81, 120, 16, ES_AUTOHSCROLL | ES_READONLY | ES_CENTER | WS_TABSTOP
  LTEXT         "Start/stop recording", IDC_KEY_RECORDING_LABEL, 138, 111, 140, 10
  EDITTEXT      IDC_KEY_RECORDING, 286, 107, 120, 16, ES_AUTOHSCROLL | ES_READONLY | ES_CENTER | WS_TABSTOP
  LTEXT         "Save screenshot", IDC_KEY_SCREENSHOT_LABEL, 138, 137, 140, 10
  EDITTEXT      IDC_KEY_SCREENSHOT, 286, 133, 120, 16, ES_AUTOHSCROLL | ES_READONLY | ES_CENTER | WS_TABSTOP
  LTEXT         "Open Settings", IDC_KEY_SETTINGS_LABEL, 138, 163, 140, 10
  EDITTEXT      IDC_KEY_SETTINGS, 286, 159, 120, 16, ES_AUTOHSCROLL | ES_READONLY | ES_CENTER | WS_TABSTOP
  PUSHBUTTON    "Restore defaults", IDC_KEYBINDS_DEFAULTS, 138, 202, 94, 16

  // Session history
  LTEXT         "Session history", IDC_HISTORY_TITLE, 124, 8, 296, 14
  LTEXT         "Rename, play or remove past mirroring sessions.", IDC_HISTORY_INFO, 124, 24, 296, 9
  GROUPBOX      "Sessions", IDC_HISTORY_GROUP, 124, 40, 298, 192
  CONTROL       "", IDC_SESSIONS, "SysListView32",
                LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_EDITLABELS | WS_BORDER | WS_TABSTOP,
                134, 54, 278, 148
  PUSHBUTTON    "Re&name", IDC_RENAME, 134, 208, 60, 16
  PUSHBUTTON    "&Play recording", IDC_PLAY, 200, 208, 76, 16
  PUSHBUTTON    "&Delete", IDC_DELETE, 282, 208, 60, 16

  // Updates
  LTEXT         "Updates", IDC_UPDATES_TITLE, 124, 8, 296, 14
  LTEXT         "Choose how OpenMirrorPhone checks for new versions.", IDC_UPDATES_INFO, 124, 24, 296, 9
  GROUPBOX      "Update preferences", IDC_UPDATES_GROUP, 124, 40, 298, 60
  AUTOCHECKBOX  "Check for updates on GitHub when OpenMirrorPhone starts", IDC_AUTO_UPDATE, 134, 56, 278, 10
  PUSHBUTTON    "&Check for updates", IDC_CHECK_UPDATES_NOW, 134, 76, 90, 16
  LTEXT         "", IDC_UPDATE_STATUS, 232, 80, 180, 9
  GROUPBOX      "What's new in this version", IDC_WHATS_NEW_GROUP, 124, 108, 298, 124
  EDITTEXT      IDC_WHATS_NEW_TEXT, 134, 122, 278, 102,
                ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

  // About
  LTEXT         "About", IDC_ABOUT_TITLE, 124, 8, 296, 14
  LTEXT         "The app and the project.", IDC_ABOUT_INFO, 124, 24, 296, 9
  GROUPBOX      "", IDC_ABOUT_GROUP, 124, 40, 298, 92
  LTEXT         "OpenMirrorPhone", IDC_ABOUT_PRODUCT, 134, 56, 278, 16
  LTEXT         "Version 0.1.1", IDC_ABOUT_VERSION, 134, 74, 278, 9
  LTEXT         "Mirror your iPhone, iPad or Mac screen to this PC. No app is needed on the phone.\n\nFree and open source, licensed under the GPLv3.",
                IDC_ABOUT_DESCRIPTION, 134, 90, 278, 36

  PUSHBUTTON    "Close", IDCANCEL, 362, 240, 60, 15
END

IDD_UPDATE DIALOGEX 0, 0, 320, 230
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Update available"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT         "", IDC_UPD_TITLE, 7, 8, 306, 18
  EDITTEXT      IDC_UPD_NOTES, 7, 28, 306, 160,
                ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
  CONTROL       "", IDC_UPD_PROGRESS, "msctls_progress32", 0, 7, 192, 306, 10
  PUSHBUTTON    "&Skip this version", IDC_UPD_SKIP, 7, 208, 88, 15
  PUSHBUTTON    "&Later", IDCANCEL, 159, 208, 60, 15
  DEFPUSHBUTTON "&Install and restart", IDOK, 223, 208, 90, 15
END

IDD_WELCOME DIALOGEX 0, 0, 290, 186
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "" // the bold heading inside already says it
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
  LTEXT         "Welcome to OpenMirrorPhone!", IDC_WELCOME_TITLE, 12, 10, 266, 14
  LTEXT         "OpenMirrorPhone is completely free. There are no paid features, no ads and no time limits: everything is included, and it will stay that way.",
                -1, 12, 30, 266, 18
  LTEXT         "To get started, open Control Center on your iPhone or iPad, tap Screen Mirroring and choose this PC.",
                -1, 12, 54, 266, 18
  LTEXT         "If you find it useful and would like to support its development, you can make a donation with PayPal. Thank you!",
                -1, 12, 78, 266, 18
  CONTROL       "Donate with PayPal", IDC_DONATE, "Button", BS_OWNERDRAW | WS_TABSTOP, 75, 100, 140, 44
  DEFPUSHBUTTON "Get started", IDOK, 203, 162, 75, 15
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName",      "OpenMirrorPhone"
      VALUE "FileDescription",  "OpenMirrorPhone - screen mirroring receiver"
      VALUE "FileVersion",      "0.1.1"
      VALUE "ProductVersion",   "0.1.1"
      VALUE "OriginalFilename", "OpenMirrorPhone.exe"
      VALUE "LegalCopyright",   "GPLv3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
